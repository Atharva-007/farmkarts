rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to read/write products
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.uid == resource.data.sellerId || request.auth.uid == request.resource.data.sellerId);
      allow delete: if request.auth != null && request.auth.uid == resource.data.sellerId;
    }
    
    // Allow authenticated users to read/write their own orders
    match /orders/{orderId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.buyerId || 
         request.auth.uid == resource.data.sellerId ||
         request.auth.uid == request.resource.data.buyerId || 
         request.auth.uid == request.resource.data.sellerId);
    }
    
    // Allow authenticated users to read/write their own cart items
    match /cart/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow reading categories for all authenticated users
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins can modify (handle separately)
    }
    
    // Allow authenticated users to read/write reviews
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId);
    }
    
    // Conversations - allow read/write for participants
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
        
      // Messages within conversations
      match /messages/{messageId} {
        allow read, write: if request.auth != null && 
          (request.auth.uid == resource.data.senderId || 
           request.auth.uid == resource.data.receiverId ||
           request.auth.uid == request.resource.data.senderId || 
           request.auth.uid == request.resource.data.receiverId);
      }
    }
    
    // User conversation metadata
    match /user_conversations/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /conversations/{conversationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // AI Chat Sessions - IMPROVED PERMISSIONS
    match /ai_chat_sessions/{sessionId} {
      // Allow users to create their own AI chat sessions
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      
      // Allow users to read and update their own sessions
      allow read, update: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      
      // Allow users to delete their own sessions
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
        
      // Messages within AI chat sessions
      match /messages/{messageId} {
        // Allow users to create messages in their own sessions
        allow create: if request.auth != null && 
          request.auth.uid == get(/databases/$(database)/documents/ai_chat_sessions/$(sessionId)).data.userId;
        
        // Allow users to read messages from their own sessions
        allow read: if request.auth != null && 
          request.auth.uid == get(/databases/$(database)/documents/ai_chat_sessions/$(sessionId)).data.userId;
        
        // Allow users to update messages in their own sessions
        allow update: if request.auth != null && 
          request.auth.uid == get(/databases/$(database)/documents/ai_chat_sessions/$(sessionId)).data.userId;
      }
    }
    
    // Test collection for connection testing - allow all authenticated users
    match /test/{document} {
      allow read, write: if request.auth != null;
    }
    
    // Buy requests (legacy support)
    match /buyRequests/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Seller inbox (legacy support)
    match /sellerInbox/{sellerId} {
      allow read, write: if request.auth != null && request.auth.uid == sellerId;
    }
  }
}
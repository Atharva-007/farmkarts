                        radius: 24,
                        backgroundColor: AppTheme.primaryGreen,
                        child: Text(
                          conversation.buyerName.isNotEmpty
                              ? conversation.buyerName[0].toUpperCase()
                              : 'B',
                          style: const TextStyle(
                            color: Colors.white,
                            fontWeight: FontWeight.bold,

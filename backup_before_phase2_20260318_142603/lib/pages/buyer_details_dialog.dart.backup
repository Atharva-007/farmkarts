  Future<void> _showBuyerDetails(String buyerId, String buyerName) async {
    try {
      final buyerDetails = await _chatService.getBuyerDetails(buyerId);
      
      showDialog(
        context: context,
        builder: (context) => AlertDialog(
          title: Text('$buyerName Details'),
          content: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                _buildDetailRow('Name', buyerDetails['name'] ?? 'Unknown'),
                if (buyerDetails['email']?.isNotEmpty == true)
                  _buildDetailRow('Email', buyerDetails['email']),
                if (buyerDetails['phone']?.isNotEmpty == true)
                  _buildDetailRow('Phone', buyerDetails['phone']),
                if (buyerDetails['location']?.isNotEmpty == true)
                  _buildDetailRow('Location', buyerDetails['location']),
                
                const SizedBox(height: 16),
                
                // Rating section
                const Text(
                  'Rating:',
                  style: TextStyle(fontWeight: FontWeight.bold),
                ),
                const SizedBox(height: 8),
                Row(
                  children: [
                    ...List.generate(5, (index) {
                      return Icon(
                        index < (buyerDetails['rating'] ?? 0).round()
                            ? Icons.star
                            : Icons.star_border,
                        color: Colors.orange,
                        size: 20,
                      );
                    }),
                    const SizedBox(width: 8),
                    Text(
                      '${(buyerDetails['rating'] ?? 0).toStringAsFixed(1)} '
                      '(${buyerDetails['totalRatings'] ?? 0} reviews)',
                      style: const TextStyle(fontSize: 14),
                    ),
                  ],
                ),
                
                const SizedBox(height: 16),
                
                // Member since
                Row(
                  children: [
                    const Icon(Icons.calendar_month, size: 16, color: Colors.grey),
                    const SizedBox(width: 4),
                    Text(
                      'Member since ${_formatDate(buyerDetails['joinDate'] ?? DateTime.now())}',
                      style: const TextStyle(fontSize: 12, color: Colors.grey),
                    ),
                  ],
                ),
              ],
            ),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(context),
              child: const Text('Close'),
            ),
            if (buyerDetails['phone']?.isNotEmpty == true)
              ElevatedButton.icon(
                onPressed: () {
                  Navigator.pop(context);
                  // Add phone call functionality here
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(
                      content: Text('Call feature will be implemented soon'),
                    ),
                  );
                },
                icon: const Icon(Icons.phone, size: 16),
                label: const Text('Call'),
                style: ElevatedButton.styleFrom(
                  backgroundColor: AppTheme.primaryGreen,
                  foregroundColor: Colors.white,
                ),
              ),
          ],
        ),
      );
    } catch (e) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Failed to load buyer details: $e'),
          backgroundColor: AppTheme.error,
        ),
      );
    }
  }


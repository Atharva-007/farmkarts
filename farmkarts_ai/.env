# FarmKart AI Enhanced Service Configuration
AI_INTERNAL_KEY=farmkart_internal_2024
OLLAMA_MODEL=phi3:latest
AI_SERVICE_HOST=localhost
AI_SERVICE_PORT=8000

# Node Proxy Configuration
FIREBASE_CRED_PATH=./secrets/firebase-admin.json
PORT=3000
AI_URL=http://localhost:8000/ask

# CORS Configuration
CORS_ORIGINS=*

# RAG Configuration
SIMILARITY_THRESHOLD=0.3
MAX_CONTEXT_CHUNKS=5
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Paths
CORPUS_FILE=ai_service/corpus.jsonl
FAISS_INDEX_PATH=ai_service/faiss_index.bin
FAISS_META_PATH=ai_service/faiss_meta.json

# Response Configuration
MAX_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9
REQUEST_TIMEOUT=45
MAX_QUERY_LENGTH=1000

# Performance Configuration
ENABLE_CACHING=true
CACHE_TTL=300
MAX_CONCURRENT_REQUESTS=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s